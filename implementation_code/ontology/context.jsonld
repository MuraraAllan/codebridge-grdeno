{
  "@context": {
    "ex": "http://labx.ai/ontology#",
    "prov": "http://www.w3.org/ns/prov#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "Document": "ex:Document",
    "Feature": "ex:Feature",
    "Partial": "ex:Partial",
    "Task": "ex:Task",
    "Execution": "ex:Execution",
    "Landscape": "ex:Landscape",
    "StateTransition": "ex:StateTransition",
    "ValidationResult": "ex:ValidationResult",
    "InferredMacroState": "ex:InferredMacroState",
    "Lastring": "ex:Lastring",
    "DeveloperAgent": "ex:DeveloperAgent",
    "DocumentationAgent": "ex:DocumentationAgent",
    "QAAgent": "ex:QAAgent",
    "OntologyController": "ex:OntologyController",
    "HumanReviewer": "ex:HumanReviewer",
    "hasFeature": { "@id": "ex:hasFeature", "@type": "@id" },
    "hasPartial": { "@id": "ex:hasPartial", "@type": "@id" },
    "target": { "@id": "ex:target", "@type": "@id" },
    "parentAnchor": { "@id": "ex:parentAnchor", "@type": "@id" },
    "fromState": { "@id": "ex:fromState", "@type": "@id" },
    "toState": { "@id": "ex:toState", "@type": "@id" },
    "timestamp": { "@id": "prov:endedAtTime", "@type": "xsd:dateTime" },
    "wasAssociatedWith": { "@id": "prov:wasAssociatedWith", "@type": "@id" },
    "previousActivity": { "@id": "ex:previousActivity", "@type": "@id" },
    "validationRef": { "@id": "ex:validationRef", "@type": "@id" },
    "axiomRef": { "@id": "ex:axiomRef", "@type": "@id" },
    "domainScope": { "@id": "ex:domainScope", "@type": "@id" },
    "landscapeRef": { "@id": "ex:landscapeRef", "@type": "@id" },
    "ontologyMode": "ex:ontologyMode",
    "eventType": "ex:eventType",
    "status": "ex:status",
    "details": "ex:details",
    "occurrence": "ex:occurrence",
    "submittedBy": "ex:submittedBy",
    "assignee": "ex:assignee",
    "securityReview": "ex:securityReview",
    "detailedReasoning": "ex:detailedReasoning",
    "integerDuration": "ex:integerDuration",
    "tokens": "ex:tokens",
    "errored": "ex:errored",
    "validationRule": "ex:validationRule",
    "recoveryAction": "ex:recoveryAction",
    "sourceArtifact": { "@id": "ex:sourceArtifact", "@type": "@id" },
    "closedEventChain": { "@id": "ex:closedEventChain", "@type": "@id" },
    "validationResult": { "@id": "ex:validationResult", "@type": "@id" },
    "approvedBy": { "@id": "ex:approvedBy", "@type": "@id" },
    "registeredAt": { "@id": "ex:registeredAt", "@type": "xsd:dateTime" }
  }
}
