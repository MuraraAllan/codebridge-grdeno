PREFIX ex: <http://labx.ai/ontology#>
PREFIX prov: <http://www.w3.org/ns/prov#>

# Current state by latest timestamp.
SELECT ?target ?state ?transition ?timestamp
WHERE {
  ?transition a ex:StateTransition ;
    ex:target ?target ;
    ex:toState ?state ;
    prov:endedAtTime ?timestamp .

  FILTER NOT EXISTS {
    ?otherTransition a ex:StateTransition ;
      ex:target ?target ;
      prov:endedAtTime ?otherTimestamp .
    FILTER(?otherTimestamp > ?timestamp)
  }
}

# Rejected Partial -> BlockedByPartial Feature.
CONSTRUCT {
  ?feature ex:macroStatus ex:BlockedByPartial .
}
WHERE {
  ?feature ex:hasPartial ?partial .
  ?transition a ex:StateTransition ;
    ex:target ?partial ;
    ex:toState ex:Rejected ;
    prov:endedAtTime ?timestamp .

  FILTER NOT EXISTS {
    ?otherTransition a ex:StateTransition ;
      ex:target ?partial ;
      prov:endedAtTime ?otherTimestamp .
    FILTER(?otherTimestamp > ?timestamp)
  }
}

# Released code -> InferredOutdated document.
CONSTRUCT {
  ?document ex:macroStatus ex:InferredOutdated .
}
WHERE {
  ?document ex:hasFeature ?feature .
  ?feature ex:hasPartial ?partial .
  ?transition a ex:StateTransition ;
    ex:target ?partial ;
    ex:toState ex:Released ;
    prov:endedAtTime ?timestamp .
}

# Synchronized release readiness for code and documentation.
SELECT ?document ?feature ?partial ?codeReleaseTransition ?documentReleaseTransition
WHERE {
  ?document ex:hasFeature ?feature .
  ?feature ex:hasPartial ?partial .

  ?codeReleaseTransition a ex:StateTransition ;
    ex:target ?partial ;
    ex:toState ex:Released ;
    prov:endedAtTime ?codeTimestamp .

  ?documentReleaseTransition a ex:StateTransition ;
    ex:target ?document ;
    ex:toState ex:Released ;
    prov:endedAtTime ?documentTimestamp .

  FILTER NOT EXISTS {
    ?laterCodeTransition a ex:StateTransition ;
      ex:target ?partial ;
      prov:endedAtTime ?laterCodeTimestamp .
    FILTER(?laterCodeTimestamp > ?codeTimestamp)
  }

  FILTER NOT EXISTS {
    ?laterDocumentTransition a ex:StateTransition ;
      ex:target ?document ;
      prov:endedAtTime ?laterDocumentTimestamp .
    FILTER(?laterDocumentTimestamp > ?documentTimestamp)
  }
}
