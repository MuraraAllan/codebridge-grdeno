2. O Script de Automação (scripts/generate-event.js)
Crie o arquivo em scripts/generate-event.js. Ele mapeia as variáveis dinâmicas do Git para a ontologia de processos (PROV-O).
javascript
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');

// 1. Caminhos dos arquivos
const PAYLOAD_PATH = path.join(__dirname, '../dist/graph-payload.jsonld');

// 2. Coleta de Metadados do Git via CLI
try {
    const commitHash = execSync('git rev-parse HEAD').toString().trim();
    const branchName = execSync('git rev-parse --abbrev-ref HEAD').toString().trim();
    const authorName = execSync('git log -1 --format="%an"').toString().trim();
    const authorEmail = execSync('git log -1 --format="%ae"').toString().trim();
    const timestamp = new Date().toISOString();

    // 3. Define a micro-tarefa alvo baseado no escopo da branch
    // Se a branch começar com 'fix/partial-', extrai o ID do componente
    let targetComponent = "ex:part_input_field"; // Alvo padrão (Fallback)
    if (branchName.includes('partial-')) {
        const parts = branchName.split('partial-');
        targetComponent = `ex:part_${parts[1]}`;
    } else if (branchName.includes('feature-')) {
        const parts = branchName.split('feature-');
        targetComponent = `ex:feat_${parts[1]}`;
    }

    // 4. Carrega o Grafo JSON-LD existente
    if (!fs.existsSync(PAYLOAD_PATH)) {
        console.error("❌ Erro: Arquivo graph-payload.jsonld não encontrado na pasta dist/.");
        process.exit(1);
    }
    
    let graphData = JSON.parse(fs.readFileSync(PAYLOAD_PATH, 'utf8'));

    // 5. Cria o ID único para a nova atividade de transição (Process Ontology)
    const newActivityId = `ex:transition_activity_${Date.now()}`;
    const agentId = `ex:user_dev_${authorName.toLowerCase().replace(/[^a-z0-9]/g, '_')}`;

    // 6. Registra o Agente (Desenvolvedor) se ele não existir no grafo
    const agentExists = graphData["@graph"].some(node => node["@id"] === agentId);
    if (!agentExists) {
        graphData["@graph"].push({
            "@id": agentId,
            "@type": "prov:Agent",
            "rdf:type": "ex:Developer",
            "ex:name": authorName,
            "ex:email": authorEmail
        });
    }

    // 7. Injeta o novo evento de transição de estado assíncrono (Micro-Tarefa Autônoma)
    const newTransitionEvent = {
        "@id": newActivityId,
        "@type": "StateTransition",
        "target": targetComponent,
        "fromState": "ex:Draft",         // Em produção, isso pode ser lido do estado anterior via SPARQL
        "toState": "ex:Review",          // Mapeado automaticamente para o estágio de Code Review
        "timestamp": timestamp,
        "wasAssociatedWith": agentId,
        "usedSoftware": "ex:pipeline_github_actions",
        "commitHash": commitHash,
        "branch": branchName
    };

    graphData["@graph"].push(newTransitionEvent);

    // 8. Grava o payload atualizado preservando a estrutura tradicional
    fs.writeFileSync(PAYLOAD_PATH, JSON.stringify(graphData, null, 2), 'utf8');
    console.log(`\n✅ [Ontology Track] Novo evento registrado com sucesso para o componente: ${targetComponent}`);
    console.log(`🔗 Activity ID: ${newActivityId} | Commit: ${commitHash.substring(0, 7)}`);

} catch (error) {
    console.error("❌ Falha ao injetar metadados ontológicos baseados no Git:", error.message);
    process.exit(1);
}
Use o código com cuidado.

