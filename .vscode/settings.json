{
    "git.confirmEmptyCommits": false,
    "git.commitShortHashLength": 7,
    "git.defaultBranchName": "main",
    "git.detectSubmodules": false,
    "git.diagnosticsCommitHook.enabled": false,
    "git.enabled": false,
    "git.enableStatusBarSync": false,
    "editor.experimental.asyncTokenization": false,
    "terminal.integrated.tabs.defaultIcon": "scrollbar-button-left",
    "ipynb.pasteImagesAsAttachments.enabled": false,
    "markdown.editor.filePaste.enabled": "never",
    "markdown.editor.pasteUrlAsFormattedLink.enabled": "never",
    "markdown.editor.updateLinksOnPaste.enabled": false,
    "editor.autoIndent": "none",
    "ipynb.experimental.serialization": false,
    "editor.defaultFoldingRangeProvider": "vscode.json-language-features",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.foldingStrategy": "indentation",
    "editor.wrappingIndent": "none",
    "editor.autoIndentOnPasteWithinString": false,
    "editor.detectIndentation": false,
    "editor.guides.indentation": false
}